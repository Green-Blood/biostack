API_SECRET_KEY=change-me
# Needed for PDF reading, the daily summary and "Ask the AI".
# AI_PROVIDER=gemini (default) or openai_compat (Ollama, LM Studio, OpenAI, OpenRouter).
# AI_PROVIDER=gemini
# Key: Google AI Studio. For cheap questions pick a Flash-Lite model from Google's current list as GEMINI_MODEL.
GEMINI_API_KEY=
GEMINI_MODEL=
# OpenAI-compatible provider (when AI_PROVIDER=openai_compat):
# Example (local Ollama): OPENAI_BASE_URL=http://localhost:11434/v1  OPENAI_MODEL=qwen2.5:14b
# OPENAI_BASE_URL=
# OPENAI_API_KEY=
# OPENAI_MODEL=
API_BASE_URL=http://localhost:8000
# Optional password gate for the web UI when deployed behind a reverse proxy (leave empty to disable).
# BIOSTACK_ACCESS_PASSWORD=
# Tests and scratch stacks only: BIOSTACK_FAKE_AI=1 swaps Gemini for a fixed fake and requires APP_ENV=test.
# APP_ENV=
# BIOSTACK_FAKE_AI=

# Opt in to the 3-hourly Open-Meteo environment refresh (needs a location in Settings).
# ENABLE_SCHEDULER=1

# --- Home server (docker compose; see docs/SERVER.md) ---
# Hostname(s) you open BioStack under besides localhost, comma separated, e.g. your Tailscale name.
# ALLOWED_HOSTS=myserver.tail1234.ts.net
# Host port for the web app (bound to 127.0.0.1; tailscale serve publishes it to your devices).
# WEB_PORT=3410

# Telegram bot (optional). Token: talk to @BotFather. Owner id: send /id to the bot once, then put the number here.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_OWNER_ID=
# Bot language: en or ru (default: en)
# BOT_LANG=en
